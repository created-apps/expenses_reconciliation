# Copy to backend/.env and fill in. backend/.env is git-ignored. Never commit real values.

# Supabase (service-role key lives ONLY here, never in the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# User tokens are verified against the project's JWKS (public keys) endpoint:
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Not used (this project uses JWT signing keys); kept optional.
SUPABASE_JWT_SECRET=

# Comma-separated list of emails allowed to use the app. Empty = nobody is allowed.
# Public sign-ups are open on the shared Supabase project, so this list is the only gate.
ALLOWED_EMAILS=

# Claude vision (invoice images and scanned PDFs). The model name is never hard-coded.
# ANTHROPIC_MODEL must be an exact model ID (no quotes, no spaces), for example claude-sonnet-5-5.
# Leave either empty and images simply stay "Waiting for AI" (values can be typed in by hand).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

STORAGE_BUCKET=recon-files

# Optional upload limits (these are the defaults). MB unless stated.
# MAX_FILE_MB=50
# MAX_REQUEST_MB=400
# MAX_ZIP_TOTAL_MB=300
# MAX_ZIP_ENTRIES=1000
# SIGNED_URL_SECONDS=300

# Comma-separated list of frontend origins
CORS_ORIGINS=http://localhost:5173
