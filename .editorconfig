# UTF-8 and LF everywhere, so special characters (₹ – − · …) are never re-encoded by an editor or script.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{ts,tsx,js,json,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.{py,toml}]
indent_style = space
indent_size = 4

[*.sql]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
