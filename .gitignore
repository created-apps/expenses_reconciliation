# Secrets: never commit real env files (the .example files are tracked)
.env
.env.*
!.env.example

# Real client files (statements, invoices, Amazon reports). Never commit.
# The folder itself is kept (.gitkeep) so it exists after a clone.
backend/tests/fixtures_private/*
!backend/tests/fixtures_private/.gitkeep

